# Copy this file to .env before running `docker compose up`.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# Supported values: groq | mock | local
#   groq  -> Groq's OpenAI-compatible API (requires LLM_API_KEY)
#   mock  -> deterministic offline provider, useful for trying the stack out
#   local -> placeholder, not implemented yet
LLM_PROVIDER=groq

# Required when LLM_PROVIDER=groq
LLM_API_KEY=your_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Conversation history file used by FileMemory.
MEMORY_PATH=data/conversation.json

# PostgreSQL + pgvector connection string.
# Inside Docker Compose the host is the `postgres` service name.
# For local (non-Docker) development use: postgresql://ai_assistant:ai_assistant@localhost:5432/ai_assistant
POSTGRES_CONNECTION_STRING=postgresql://ai_assistant:ai_assistant@postgres:5432/ai_assistant

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Supported values: development | production
ENVIRONMENT=development
